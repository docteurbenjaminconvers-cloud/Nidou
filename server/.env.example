# Fournisseur d'IA : anthropic ou mistral (déduit de la clé présente si vide)
NIDOU_IA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Modèle rapide (défaut) et modèle précis (repli quand la confiance < NIDOU_SEUIL_CONFIANCE)
NIDOU_MODEL_RAPIDE=claude-haiku-5-5
NIDOU_MODEL_PRECIS=claude-sonnet-5-5
NIDOU_SEUIL_CONFIANCE=0.7
# Coût estimé d'une lecture, en centimes, pour le suivi des dépenses et le plafond du gratuit
NIDOU_COUT_RAPIDE_CENTIMES=0.5
NIDOU_COUT_PRECIS_CENTIMES=2
# Lectures IA par mois offertes au plan gratuit (0 = lecture locale uniquement, zéro coût IA sur le gratuit)
NIDOU_IA_LECTURES_GRATUIT=0
# Plafond mensuel des dépenses d'IA des comptes gratuits si un quota est ouvert (au-delà, lecture locale jusqu'au mois suivant)
NIDOU_IA_PLAFOND_GRATUIT_EUR=2000
# Essai inversé : jours de plan Famille complet offerts à l'inscription
NIDOU_ESSAI_JOURS=15
# Comptes : 1 (défaut) = connexion par lien magique, chaque foyer a ses comptes ; 0 = prototype mono-foyer sans connexion
NIDOU_AUTH=1
# Expéditeur des emails (liens de connexion, invitations, rappels). Envoi via Brevo si BREVO_API_KEY est renseignée, sinon console.
NIDOU_EMAIL_FROM=Nidou <bonjour@nidou.fr>
# Jeton MCP de secours pour le premier foyer (chaque foyer a son propre jeton, visible dans les réglages)
NIDOU_MCP_TOKEN=
# Catégories jamais exposées au connecteur
NIDOU_MCP_EXCLUDE=sante,banque
# Port HTTP
PORT=3000
# Charger la famille de démonstration au premier lancement
NIDOU_SEED=0

# Connexion bancaire via Enable Banking (fournisseur par défaut : facturé par compte connecté et par mois, appels compris).
# Identifiant de l'application et sa clé privée (.pem téléchargée à la création de l'application dans le Control Panel).
# Redirect URL à déclarer dans l'application : NIDOU_PUBLIC_URL/api/bank/eb/callback
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY_FILE=/data/enablebanking.pem
# Durée de l'autorisation demandée à la banque, en jours (180 maximum ; la limite de la banque s'applique si elle est plus courte)
ENABLEBANKING_CONSENT_DAYS=180

# Connexion bancaire via Bridge (bridgeapi.io, version 2025-01-15), en secours. Sans aucune clé : banque simulée.
# NIDOU_BANQUE=bridge force Bridge si les deux fournisseurs sont configurés.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
# Secret du webhook créé dans le dashboard Bridge (événements item.refreshed, item.created, item.account.updated)
BRIDGE_WEBHOOK_SECRET=
# URL publique de Nidou (HTTPS) : sert au callback de Bridge Connect et au webhook
NIDOU_PUBLIC_URL=https://app.nidou.fr

# Adresse de transfert : chaque foyer reçoit nid-<code>@NIDOU_INBOX_DOMAIN. Le fournisseur de réception (Brevo inbound parsing,
# OVH, Postmark…) poste les emails sur POST /api/inbox?secret=NIDOU_INBOX_SECRET.
NIDOU_INBOX_DOMAIN=in.nidou.fr
NIDOU_INBOX_SECRET=changez-moi-aussi
# Clé API Brevo, seulement si la réception passe par Brevo (téléchargement des pièces jointes)
BREVO_API_KEY=

# Paiement du plan Famille (Stripe). Sans clé : mode simulé (le bouton active le plan sans paiement).
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (événements checkout.session.completed, customer.subscription.*, invoice.payment_failed) vers NIDOU_PUBLIC_URL/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Identifiants des six prix créés dans Stripe (formule × période), TTC :
# Solo 6,90 €/mois · 69 €/an — Duo 9,90 €/mois · 99 €/an — Tribu 13,90 €/mois · 139 €/an
STRIPE_PRICE_SOLO_MENSUEL=
STRIPE_PRICE_SOLO_ANNUEL=
STRIPE_PRICE_DUO_MENSUEL=
STRIPE_PRICE_DUO_ANNUEL=
STRIPE_PRICE_TRIBU_MENSUEL=
STRIPE_PRICE_TRIBU_ANNUEL=
# Veille bancaire d'un proche, en supplément (3,90 € / mois ou 39 € / an par personne ; Tribu en comprend une)
STRIPE_PRICE_VEILLE_MENSUEL=
STRIPE_PRICE_VEILLE_ANNUEL=

# Veille bancaire d'un proche : FERMÉE tant que l'avocat n'a pas validé le cadre (mettre 1 pour l'ouvrir)
NIDOU_VEILLE=0
# Jours de conservation des opérations après la fin d'une veille (le journal est gardé)
NIDOU_VEILLE_CONSERVATION_JOURS=90

# Notifications push (Web Push / VAPID). Générer les clés : npx web-push generate-vapid-keys. Sans clés : rappels dans la console.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@nidou.fr

# --- Assistant « Demander à Nidou » (option payante 2,90 €/mois ou 29 €/an) ---
# Utilise ANTHROPIC_API_KEY. Prix Stripe de l'option, ajoutée à l'abonnement existant :
# STRIPE_PRICE_ASSISTANT_MENSUEL=price_...
# STRIPE_PRICE_ASSISTANT_ANNUEL=price_...
# NIDOU_ASSISTANT_MODEL=claude-haiku-5-5
# NIDOU_ASSISTANT_QUESTIONS_MOIS=300        # quota par foyer avec l'option
# NIDOU_ASSISTANT_QUESTIONS_ESSAI=20        # questions offertes pendant l'essai
# NIDOU_ASSISTANT_PLAFOND_EUR=300           # dépense IA mensuelle max, tous foyers confondus
# Tarifs en USD par million de jetons (Haiku 5.5) et taux USD→EUR, pour le suivi des coûts :
# NIDOU_ASSISTANT_PRIX_ENTREE=0.10
# NIDOU_ASSISTANT_PRIX_SORTIE=0.50
# NIDOU_USD_EUR=0.92
